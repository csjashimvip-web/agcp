COMPOSE_PROJECT_NAME=agcp
APP_PORT=8080

APP_NAME="Araabi Global Commerce Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=CHANGE_ME_APP_KEY
APP_PREVIOUS_KEYS=
APP_VERSION=4.0.0-phase4
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agcp
DB_USERNAME=agcp
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

FRONTEND_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME="Araabi Global Commerce Platform"
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_TELEMETRY_DISABLED=1

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080,127.0.0.1
FORTIFY_PREFIX=api/v1/auth
PASSWORD_RESET_URL=http://localhost:8080/reset-password
EMAIL_VERIFICATION_URL=http://localhost:8080/verify-email
PASSKEYS_USER_HANDLE_SECRET=CHANGE_ME_PASSKEYS_SECRET
PASSKEYS_ALLOWED_ORIGINS=http://localhost:8080

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost.test
MAIL_FROM_NAME="Araabi Global"

TENANCY_MODE=single
PLATFORM_TENANT_HEADER=X-Tenant-ID
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
AUDIT_RETENTION_DAYS=2555

INITIAL_ADMIN_NAME="AGCP Administrator"
INITIAL_ADMIN_EMAIL=admin@localhost.test
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
