COMPOSE_PROJECT_NAME=agcp
APP_PORT=8080

APP_NAME="Araabi Global Commerce Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=CHANGE_ME_APP_KEY
APP_PREVIOUS_KEYS=
APP_VERSION=11.0.0-phase11
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agcp
DB_USERNAME=agcp
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

FRONTEND_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME="Araabi Global Commerce Platform"
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_TELEMETRY_DISABLED=1

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080,127.0.0.1
FORTIFY_PREFIX=api/v1/auth
PASSWORD_RESET_URL=http://localhost:8080/reset-password
EMAIL_VERIFICATION_URL=http://localhost:8080/verify-email
PASSKEYS_USER_HANDLE_SECRET=CHANGE_ME_PASSKEYS_SECRET
PASSKEYS_ALLOWED_ORIGINS=http://localhost:8080

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost.test
MAIL_FROM_NAME="Araabi Global"

TENANCY_MODE=single
PLATFORM_TENANT_HEADER=X-Tenant-ID
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
SUPPLIER_POLL_BATCH_SIZE=100
AUDIT_RETENTION_DAYS=2555

INITIAL_ADMIN_NAME="AGCP Administrator"
INITIAL_ADMIN_EMAIL=admin@localhost.test
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

FRAUD_REVIEW_SCORE=60
FRAUD_BLOCK_SCORE=80
FRAUD_HIGH_VALUE_MINOR=50000
FRAUD_CRITICAL_VALUE_MINOR=200000
DYNAMIC_PRICE_QUOTE_TTL=300
TENANT_DEFAULT_PLAN=enterprise
DOMAIN_VERIFICATION_MODE=manual
PLUGIN_ALLOW_UNAPPROVED=false
SAAS_USAGE_PERIOD=monthly
ANALYTICS_PROVIDER=deterministic
ANALYTICS_WINDOW_DAYS=30
ANALYTICS_FORECAST_HORIZON_DAYS=14
ANALYTICS_REFRESH_TIME=02:10

# Phase 9 payment orchestration
PAYMENT_INTENT_EXPIRY_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RECONCILIATION_WINDOW_DAYS=30
PAYMENT_RECONCILIATION_TIME=03:10
SANDBOX_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_GENERATED_64_CHAR_SECRET

# Phase 10 engagement and operations
OPERATIONS_SNAPSHOT_INTERVAL_MINUTES=5
SUPPORT_DEFAULT_FIRST_RESPONSE_MINUTES=480
SUPPORT_DEFAULT_RESOLUTION_HOURS=48
WEBHOOK_MAX_RESPONSE_BYTES=10000
WEBHOOK_ALLOW_LOG_SINK=true
NOTIFICATION_DEFAULT_PROVIDER=log

# Phase 11 reporting, invoice and export settings
REPORT_EXPORT_DISK=local
REPORT_EXPORT_DIRECTORY=exports
REPORT_EXPORT_RETENTION_DAYS=30
REPORT_SCHEDULE_BATCH_SIZE=50
INVOICE_DUE_DAYS=0

# Phase 12 reliability, backup and production-readiness settings
BACKUP_ENABLED=true
BACKUP_DISK=local
BACKUP_DIRECTORY=backups/database
BACKUP_RETENTION_DAYS=14
BACKUP_DAILY_TIME=01:30
BACKUP_MAX_AGE_HOURS=36
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
BACKUP_COMMAND_TIMEOUT_SECONDS=1800
BACKUP_ENCRYPTION_CHUNK_BYTES=1048576
MYSQLDUMP_BINARY=mysqldump
RUNTIME_HEARTBEAT_TTL_MINUTES=3
