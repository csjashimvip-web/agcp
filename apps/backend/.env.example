APP_NAME="AGCP API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=8.0.0-phase8
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agcp
DB_USERNAME=agcp
DB_PASSWORD=secret
CACHE_STORE=array
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost,127.0.0.1:8080,127.0.0.1
FORTIFY_PREFIX=api/v1/auth
PASSWORD_RESET_URL=http://localhost:8080/reset-password
EMAIL_VERIFICATION_URL=http://localhost:8080/verify-email
PASSKEYS_USER_HANDLE_SECRET=
PASSKEYS_ALLOWED_ORIGINS=http://localhost:8080
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost.test
MAIL_FROM_NAME="Araabi Global"
TENANCY_MODE=single
PLATFORM_TENANT_HEADER=X-Tenant-ID
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
SUPPLIER_POLL_BATCH_SIZE=100
INITIAL_ADMIN_NAME="AGCP Administrator"
INITIAL_ADMIN_EMAIL=admin@localhost.test
INITIAL_ADMIN_PASSWORD=

FRAUD_REVIEW_SCORE=60
FRAUD_BLOCK_SCORE=80
FRAUD_HIGH_VALUE_MINOR=50000
FRAUD_CRITICAL_VALUE_MINOR=200000
DYNAMIC_PRICE_QUOTE_TTL=300
TENANT_DEFAULT_PLAN=enterprise
DOMAIN_VERIFICATION_MODE=manual
PLUGIN_ALLOW_UNAPPROVED=false
SAAS_USAGE_PERIOD=monthly
ANALYTICS_PROVIDER=deterministic
ANALYTICS_WINDOW_DAYS=30
ANALYTICS_FORECAST_HORIZON_DAYS=14
ANALYTICS_REFRESH_TIME=02:10
