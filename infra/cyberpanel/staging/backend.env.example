APP_NAME=AGCP
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agcp_staging
DB_USERNAME=agcp_staging
DB_PASSWORD=CHANGE_ME

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

AGCP_EXTERNAL_DELIVERY_ENABLED=false

# Configure provider credentials only in the real staging .env.
# Do not commit payment, supplier, webhook, email, or license secrets.